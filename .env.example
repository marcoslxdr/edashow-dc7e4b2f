# 🚀 EdaShow Environment Variables

# Site URL (para Open Graph e compartilhamento em redes sociais)
# Em produção, use a URL real do seu site (ex: https://edashow.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database (Neon PostgreSQL)
# Obtenha a connection string no Neon Console: https://console.neon.tech
DATABASE_URL=postgresql://user:password@hostname.neon.tech/dbname?sslmode=require

# NextAuth.js v5
# Gere um secret forte: openssl rand -base64 32
NEXTAUTH_SECRET=gere-um-secret-forte-aqui
NEXTAUTH_URL=http://localhost:3000

# Vercel Blob Storage
# Obtenha o token em: Vercel Dashboard > Storage > Blob > Create Store
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxx
