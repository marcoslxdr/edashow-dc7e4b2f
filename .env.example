# 🚀 EdaShow Environment Variables

# PayloadCMS
PAYLOAD_SECRET=gerar-um-secret-forte-aqui
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Site URL (para Open Graph e compartilhamento em redes sociais)
# Em produção, use a URL real do seu site (ex: https://edashow.com.br)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (projeto atual)
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# Chave publishable (recomendada) ou anon JWT legado:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx
# Secret / service_role — nunca expor no frontend:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Database (Supabase PostgreSQL)
# Copie a URI em Session mode (porta 5432) — host típico: aws-1-sa-east-1.pooler.supabase.com
DATABASE_URI=postgresql://postgres.[project-ref]:[password]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
MIGRATE_DEST_DATABASE_URI=
# Migração entre projetos (origem):
# MIGRATE_SOURCE_URL=https://[old-ref].supabase.co
# MIGRATE_SOURCE_SERVICE_ROLE_KEY=eyJhbGciOi...
# npm run migrate:supabase:export && npm run migrate:supabase

# Supabase Storage (S3 Compatible)
# Encontre estas informações em Supabase Project Settings > API e Storage
SUPABASE_BUCKET=media
SUPABASE_REGION=us-east-1
SUPABASE_ENDPOINT=https://xxxxxx.supabase.co/storage/v1/s3
SUPABASE_ACCESS_KEY_ID=sua-access-key
SUPABASE_SECRET_ACCESS_KEY=sua-secret-key

# ==========================================
# Event photo gallery (CMS upload — Sharp / WebP)
# Opcional; valores abaixo são os defaults no código.
# EVENT_PHOTO_PUBLIC_MAX_WIDTH=1600
# EVENT_PHOTO_THUMB_WIDTH=400
# EVENT_PHOTO_WEBP_QUALITY_PUBLIC=80
# EVENT_PHOTO_WEBP_QUALITY_THUMB=70
# EVENT_PHOTO_WATERMARK_WIDTH_PCT=12
# EVENT_PHOTO_WATERMARK_PADDING_PX=24
# EVENT_PHOTO_WATERMARK_GRAVITY=southeast
# EVENT_PHOTO_WATERMARK_OPACITY=0.35
# EVENT_PHOTO_WATERMARK_ON_THUMB=0

# Auth Roles (Opcional se quiser mudar padrões)
# PAYLOAD_ADMIN_EMAIL=admin@example.com
# PAYLOAD_ADMIN_PASSWORD=password

# ==========================================
# AI Models (OpenRouter)
# ==========================================

# OpenRouter API Key - Required for AI features
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Default model for all AI operations (fallback)
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash

# Geração de posts por IA (cron Vercel, GitHub Actions, CMS /cms/ia).
# false = desligado (padrão). true = reativa geração automática e manual.
ENABLE_POST_GENERATION=false

# Cron daily-posts na Vercel (5 rascunhos/dia; capas: banco local + Pexels/Unsplash, sem Gemini).
# Pode ficar true mesmo com ENABLE_POST_GENERATION=false (CMS manual continua desligado).
ENABLE_DAILY_POSTS=true

# Post generation model - Text model for generating blog posts
# Recommended: moonshotai/kimi-k2.6 (good reasoning, PT-BR support)
# Alternatives: google/gemini-2.5-flash, anthropic/claude-3.5-sonnet
OPENROUTER_POST_MODEL=moonshotai/kimi-k2.6

# Image generation model - Model for generating cover images
# Recommended: google/gemini-2.5-flash-image (reliable image generation)
# Note: minimax/minimax-m2.7 and recraft/recraft-v4-pro do NOT support
# image generation via OpenRouter API
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# AI Temperature (0.0 - 1.0, lower = more deterministic)
# AI_TEMPERATURE=0.7

# Max tokens for AI responses
# AI_MAX_TOKENS=4000

# ==========================================
# Cron & Automation
# ==========================================

# Secret for authenticating cron requests
CRON_SECRET=your-cron-secret-here

# ==========================================
# WhatsApp Integration (Evolution API)
# ==========================================

# EVOLUTION_API_URL=https://evolution-api.example.com
# EVOLUTION_API_KEY=your-api-key
# EVOLUTION_INSTANCE=edashow
# WHATSAPP_NUMBERS=5511999999999,5511888888888

# ==========================================
# Image APIs (Optional - for stock photo fallback)
# ==========================================

# Pexels API Key - Free stock photos
PEXELS_API_KEY=your-pexels-api-key

# Unsplash Access Key - Free stock photos
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Image bank (optional overrides)
# IMAGE_BANK_COOLDOWN_DAYS=45
# IMAGE_BANK_MIN_PER_CATEGORY=12
# IMAGE_BANK_TARGET_PER_CATEGORY=15
