{
  "buildCommand": "pnpm run build",
  "devCommand": "pnpm run dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/daily-posts",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/cron/seed-image-bank",
      "schedule": "0 6 * * 0"
    }
  ],
  "env": {
    "TURBOPACK": "0"
  }
}
